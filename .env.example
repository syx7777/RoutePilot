# Copy to .env locally or export these variables in your shell.
# Do not commit real API keys.
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=your_ark_endpoint_id_here

# DeepSeek is OpenAI-compatible.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# LLM request retry policy. Set retries to 0 to disable retry.
ROUTEPILOT_LLM_RETRIES=3
ROUTEPILOT_LLM_RETRY_BACKOFF_SECONDS=5
ROUTEPILOT_LLM_RETRY_MAX_BACKOFF_SECONDS=60
ROUTEPILOT_LLM_TEMPERATURE=0.2

# Generic OpenAI-compatible provider.
ROUTEPILOT_LLM_PROVIDER=deepseek
LLM_API_KEY=your_generic_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your_model_name_here
